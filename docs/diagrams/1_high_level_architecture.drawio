<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/155.0.0.0 Safari/537.36" version="28.2.5" pages="2">
  <diagram id="high-level-arch" name="Этап 4. Архитектура верхнего уровня">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Заголовок -->
        <mxCell id="title" value="Архитектура верхнего уровня: Маркетплейс с фулфилментом (Database per Service)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="960" height="40" as="geometry" />
        </mxCell>
        <!-- Слой 1: Клиентские приложения -->
        <mxCell id="client_buyer" value="&lt;b&gt;Покупатель (Клиент)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;iOS / Android / Web&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="120" y="80" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="client_seller" value="&lt;b&gt;Продавец (Селлер)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;Личный кабинет / API&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="client_wms" value="&lt;b&gt;Сотрудник склада&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;ТСД-терминал (WMS)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="760" y="80" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="client_courier" value="&lt;b&gt;Курьер доставки&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;Мобильное приложение&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1080" y="80" width="240" height="65" as="geometry" />
        </mxCell>
        <!-- CDN + Object Storage -->
        <mxCell id="cdn_box" value="&lt;b&gt;CDN + S3 (Медиа)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;Фото товаров, статика&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=1.5;dashed=1;fontSize=12;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="1360" y="80" width="180" height="65" as="geometry" />
        </mxCell>
        <!-- Слой 2: API Gateway / Load Balancer -->
        <mxCell id="api_gateway" value="&lt;b style=&quot;font-size:15px&quot;&gt;API Gateway / Load Balancer (L7 Nginx / Envoy)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4B5563&quot; style=&quot;font-size:12px&quot;&gt;TLS Termination · Auth (JWT) · Rate Limiting (защита в Flash Sale) · Маршрутизация&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=2;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="200" y="200" width="1040" height="70" as="geometry" />
        </mxCell>
        <!-- Стрелки от клиентов к API Gateway -->
        <mxCell id="e_c1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.5;" edge="1" parent="1" source="client_buyer" target="api_gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_c2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.5;" edge="1" parent="1" source="client_seller" target="api_gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_c3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.5;" edge="1" parent="1" source="client_wms" target="api_gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_c4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.5;" edge="1" parent="1" source="client_courier" target="api_gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Слой 3: Микросервисы (Синие блоки как в примере лекции) -->
        <mxCell id="svc_catalog" value="&lt;b&gt;Сервис каталога и поиска&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#374151&quot; style=&quot;font-size:11px&quot;&gt;карточки SKU, фильтры, цены&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EBF3FE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="50" y="340" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="svc_cart" value="&lt;b&gt;Сервис корзины&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#374151&quot; style=&quot;font-size:11px&quot;&gt;состав корзины, промокоды&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EBF3FE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="300" y="340" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="svc_order" value="&lt;b&gt;Сервис заказов&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#374151&quot; style=&quot;font-size:11px&quot;&gt;оформление (Saga), статусы&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EBF3FE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="540" y="340" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="svc_inventory" value="&lt;b&gt;Сервис склада и резерва&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#374151&quot; style=&quot;font-size:11px&quot;&gt;остатки, Flash-резерв, сборка&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EBF3FE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="790" y="340" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="svc_payment" value="&lt;b&gt;Сервис платежей&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#374151&quot; style=&quot;font-size:11px&quot;&gt;холд средств, чеки, возвраты&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EBF3FE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1050" y="340" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="svc_delivery" value="&lt;b&gt;Сервис доставки и трекинга&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#374151&quot; style=&quot;font-size:11px&quot;&gt;маршруты, гео-трекинг, ETA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EBF3FE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1290" y="340" width="240" height="80" as="geometry" />
        </mxCell>
        <!-- Стрелки от Gateway к сервисам -->
        <mxCell id="e_g1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.5;" edge="1" parent="1" source="api_gateway" target="svc_catalog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_g2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.5;" edge="1" parent="1" source="api_gateway" target="svc_cart">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_g3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.5;" edge="1" parent="1" source="api_gateway" target="svc_order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_g4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.5;" edge="1" parent="1" source="api_gateway" target="svc_inventory">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_g5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.5;" edge="1" parent="1" source="api_gateway" target="svc_payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_g6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.5;" edge="1" parent="1" source="api_gateway" target="svc_delivery">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Слой 4: Собственные хранилища данных (Database per Service) -->
        <mxCell id="db_catalog" value="&lt;b&gt;Elasticsearch + PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;Полнотекстовый индекс + мастер SKU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=1.5;fontSize=12;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="50" y="480" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="db_cart" value="&lt;b&gt;Кэш Redis (Cluster)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;In-Memory сессии и корзины (TTL)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=1.5;fontSize=12;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="300" y="480" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="db_order" value="&lt;b&gt;SQL: Заказы (PostgreSQL)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;Шардирование по buyer_id + Outbox&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=1.5;fontSize=12;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="540" y="480" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="db_inventory" value="&lt;b&gt;Redis (Счётчики) + PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;Атомарный резерв + остатки ячеек&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=1.5;fontSize=12;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="790" y="480" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="db_payment" value="&lt;b&gt;SQL: Транзакции (PostgreSQL)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;Строгий ACID + Idempotency Keys&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=1.5;fontSize=12;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1050" y="480" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="db_delivery" value="&lt;b&gt;Гео-индекс (Redis) + TimeSeries&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;Текущие координаты (TTL) + треки&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=1.5;fontSize=12;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1290" y="480" width="240" height="70" as="geometry" />
        </mxCell>
        <!-- Стрелки от сервисов к их БД -->
        <mxCell id="e_db1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.5;" edge="1" parent="1" source="svc_catalog" target="db_catalog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_db2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.5;" edge="1" parent="1" source="svc_cart" target="db_cart">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_db3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.5;" edge="1" parent="1" source="svc_order" target="db_order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_db4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.5;" edge="1" parent="1" source="svc_inventory" target="db_inventory">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_db5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.5;" edge="1" parent="1" source="svc_payment" target="db_payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_db6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.5;" edge="1" parent="1" source="svc_delivery" target="db_delivery">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Слой 5: Асинхронная шина событий (Kafka) и фоновые потребители -->
        <mxCell id="kafka_bus" value="&lt;b style=&quot;font-size:14px&quot;&gt;Брокер сообщений / Шина событий (Apache Kafka)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#78350F&quot; style=&quot;font-size:11px&quot;&gt;Асинхронные топики: order.created · stock.reserved · payment.succeeded · warehouse.packed · delivery.assigned · catalog.updated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;dashed=1;fontSize=13;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="200" y="610" width="1180" height="65" as="geometry" />
        </mxCell>
        <!-- Асинхронные сервисы-потребители -->
        <mxCell id="svc_notif" value="&lt;b&gt;Сервис уведомлений&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#374151&quot; style=&quot;font-size:11px&quot;&gt;Push, SMS, Email, чеки ОФД&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EBF3FE;strokeColor=#2563EB;strokeWidth=1.5;fontSize=12;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="380" y="720" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="svc_analytics" value="&lt;b&gt;Сервис аналитики продавцов (DWH)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#374151&quot; style=&quot;font-size:11px&quot;&gt;ClickHouse: отчёты продаж, биллинг селлеров&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EBF3FE;strokeColor=#2563EB;strokeWidth=1.5;fontSize=12;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="880" y="720" width="320" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="y3LSmeQSDZrZ6aXqRLRK" name="Страница-2">
    <mxGraphModel dx="1042" dy="527" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">

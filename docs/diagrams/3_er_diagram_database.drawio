          </mxGeometry>
        </mxCell>

        <mxCell id="rel_seller_product" value="1                 N" style="endArrow=none;html=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#2563EB;" edge="1" parent="1" source="ent_seller" target="ent_product">

<mxfile host="app.diagrams.net" modified="2026-10-16T22:06:30.000Z" agent="Antigravity" version="24.0.0" type="device">
  <diagram id="er-diagram-marketplace" name="Этап 6. ER-диаграмма БД">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Заголовок -->
        <mxCell id="title" value="Заказ (Order) связывает покупателя, склад фулфилмента, курьера, оплату и товары продавцов" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1200" height="40" as="geometry" />
        </mxCell>

        <!-- Верхний ряд: Покупатель и Платёж -->
        <mxCell id="ent_buyer" value="&lt;b style=&quot;font-size:15px&quot;&gt;Покупатель (User)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;id (PK) · имя · email&lt;br&gt;телефон · адрес_доставки&lt;br&gt;created_at&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;align=left;spacingLeft=16;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="510" y="85" width="280" height="110" as="geometry" />
        </mxCell>

        <mxCell id="ent_payment" value="&lt;b style=&quot;font-size:15px&quot;&gt;Платёж (Payment)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;id (PK) · order_id (FK)&lt;br&gt;idempotency_key (UNIQUE)&lt;br&gt;amount · status · paid_at&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;align=left;spacingLeft=16;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="920" y="85" width="290" height="110" as="geometry" />
        </mxCell>

        <!-- Средний ряд: Склад фулфилмента, ЗАКАЗ (Центр), Курьер -->
        <mxCell id="ent_warehouse" value="&lt;b style=&quot;font-size:15px&quot;&gt;Склад (Warehouse)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;id (PK) · название · регион&lt;br&gt;гео_координаты · тип_склада&lt;br&gt;мощность_сборки&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;align=left;spacingLeft=16;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="290" height="115" as="geometry" />
        </mxCell>

        <mxCell id="ent_order" value="&lt;b style=&quot;font-size:16px&quot;&gt;Заказ (Order) — ЦЕНТР&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1E3A8A&quot;&gt;id (PK) · buyer_id (FK)&lt;br&gt;warehouse_id (FK) · courier_id (FK)&lt;br&gt;status · total_amount&lt;br&gt;delivery_slot · created_at&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#EBF3FE;strokeColor=#2563EB;strokeWidth=2.5;align=left;spacingLeft=18;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="500" y="305" width="320" height="145" as="geometry" />
        </mxCell>

        <mxCell id="ent_courier" value="&lt;b style=&quot;font-size:15px&quot;&gt;Курьер (Courier)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;id (PK) · имя · телефон&lt;br&gt;тип_транспорта · рейтинг&lt;br&gt;текущая_зона · статус_смены&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;align=left;spacingLeft=16;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="960" y="320" width="290" height="115" as="geometry" />
        </mxCell>

        <!-- Нижний ряд: Остаток на складе (N-M), Позиция заказа (N-M), Товар (SKU), Продавец -->
        <mxCell id="ent_stock" value="&lt;b style=&quot;font-size:15px&quot;&gt;Остаток склада (WarehouseStock)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;warehouse_id (PK, FK)&lt;br&gt;product_id (PK, FK) · bin_code&lt;br&gt;available_qty · reserved_qty&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;align=left;spacingLeft=16;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="80" y="575" width="310" height="115" as="geometry" />
        </mxCell>

        <mxCell id="ent_order_item" value="&lt;b style=&quot;font-size:15px&quot;&gt;Позиция заказа (OrderItem)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;id (PK) · order_id (FK)&lt;br&gt;product_id (FK) · seller_id (FK)&lt;br&gt;quantity · price_at_purchase&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;align=left;spacingLeft=16;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="500" y="575" width="320" height="115" as="geometry" />
        </mxCell>

        <mxCell id="ent_product" value="&lt;b style=&quot;font-size:15px&quot;&gt;Товар / SKU (Product)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;id (PK) · seller_id (FK)&lt;br&gt;category_id · название · бренд&lt;br&gt;base_price · promo_price · вес_г&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;align=left;spacingLeft=16;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="960" y="575" width="290" height="115" as="geometry" />
        </mxCell>

        <mxCell id="ent_seller" value="&lt;b style=&quot;font-size:15px&quot;&gt;Продавец (Seller / Merchant)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;id (PK) · название_магазина · ИНН&lt;br&gt;рейтинг · комиссия_процент&lt;br&gt;реквизиты_выплат&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;align=left;spacingLeft=16;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="960" y="775" width="290" height="110" as="geometry" />
        </mxCell>

        <!-- Связи с кардинальностями 1 — N -->
        <mxCell id="rel_buyer_order" value="1                 N" style="endArrow=none;html=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#2563EB;" edge="1" parent="1" source="ent_buyer" target="ent_order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_order_payment" value="1                 N" style="endArrow=none;html=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#2563EB;" edge="1" parent="1" source="ent_order" target="ent_payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_wh_order" value="1        N" style="endArrow=none;html=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#2563EB;" edge="1" parent="1" source="ent_warehouse" target="ent_order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_order_courier" value="N        1" style="endArrow=none;html=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#2563EB;" edge="1" parent="1" source="ent_order" target="ent_courier">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_order_item" value="1                 N" style="endArrow=none;html=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#2563EB;" edge="1" parent="1" source="ent_order" target="ent_order_item">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_item_product" value="N        1" style="endArrow=none;html=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#2563EB;" edge="1" parent="1" source="ent_order_item" target="ent_product">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_wh_stock" value="1                 N" style="endArrow=none;html=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#2563EB;" edge="1" parent="1" source="ent_warehouse" target="ent_stock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_stock_product" value="N                 1" style="endArrow=none;html=1;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;fontSize=13;fontStyle=1;fontColor=#2563EB;" edge="1" parent="1" source="ent_stock" target="ent_product">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="235" y="740" />
              <mxPoint x="880" y="740" />

<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/155.0.0.0 Safari/537.36" version="28.2.5">
  <diagram id="flash-sale-deep-dive" name="Этап 5. Разбор сложного узла (Резерв стока в Flash Sale)">
    <mxGraphModel dx="1737" dy="878" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Глубокий разбор узла: Резервирование остатков при Flash Sale (50 000 RPS на 1 000 единиц SKU)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;fontStyle=1;fontColor=#111827;" parent="1" vertex="1">
          <mxGeometry x="60" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="panel_naive" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="60" y="75" width="1460" height="230" as="geometry" />
        </mxCell>
        <mxCell id="naive_title" value="&lt;b&gt;1. ПРОБЛЕМА: Почему наивный подход (SELECT ... FOR UPDATE в SQL) падает при росте нагрузки&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#991B1B;" parent="1" vertex="1">
          <mxGeometry x="85" y="85" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n_users" value="&lt;b&gt;50 000 покупателей / сек&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;нажимают «Купить» на 1 SKU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#EF4444;strokeWidth=1.5;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="90" y="140" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n_svc" value="&lt;b&gt;Сервис склада (Инстансы)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;Открывают 50 000 транзакций&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#EF4444;strokeWidth=1.5;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="410" y="140" width="240" height="75" as="geometry" />
        </mxCell>
        <mxCell id="LAilTvzm2D3YclKMurjR-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="n_lock" target="n_crash">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n_lock" value="&lt;b&gt;Очередь блокировок строки (Row Lock)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#991B1B&quot;&gt;UPDATE stock SET qty = qty - 1 WHERE sku = 42&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;Последовательное ожидание (Сериализация)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="740" y="135" width="350" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n_crash" value="&lt;b&gt;Отказ БД (Cascading Failure)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#991B1B&quot;&gt;• Исчерпание пула коннектов&lt;br&gt;• Latency &gt; 30 сек (Timeouts)&lt;br&gt;• Падение всего маркетплейса&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1180" y="135" width="310" height="85" as="geometry" />
        </mxCell>
        <mxCell id="e_n1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#DC2626;strokeWidth=2;" parent="1" source="n_users" target="n_svc" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_n2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#DC2626;strokeWidth=2;" parent="1" source="n_svc" target="n_lock" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_n3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#DC2626;strokeWidth=2;" parent="1" source="n_lock" target="n_crash" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="panel_sol" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="60" y="335" width="1460" height="530" as="geometry" />
        </mxCell>
        <mxCell id="sol_title" value="&lt;b&gt;2. РЕШЕНИЕ: Шардированные In-Memory бакеты (Redis) + Мягкий резерв с TTL + Асинхронная запись через Kafka&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#166534;" parent="1" vertex="1">
          <mxGeometry x="85" y="348" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s_gateway" value="&lt;b&gt;Шаг 1. API Gateway&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#374151&quot;&gt;Rate Limiter + Anti-Bot&lt;br&gt;Хеширование по user_id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="90" y="470" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s_b1" value="&lt;b&gt;Бакет #1 (Redis Shard 1)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;sku:42:b1 = 100 шт.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;Атомарный DECR + TTL 10 мин&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="380" y="400" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s_b2" value="&lt;b&gt;Бакет #2 (Redis Shard 2)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;sku:42:b2 = 100 шт.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;Атомарный DECR + TTL 10 мин&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="380" y="490" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s_b10" value="&lt;b&gt;... Бакет #10 (Redis Shard 10)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;sku:42:b10 = 100 шт.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;Всего: 10 × 100 = 1 000 шт.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="380" y="580" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s_reject" value="&lt;b&gt;49 000 запросов (Остаток = 0)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;Мгновенный ответ за 0.3 мс:&lt;br&gt;«Товар раскуплен» (БД не трогаем!)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;dashed=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="380" y="690" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s_kafka" value="&lt;b&gt;Шаг 3. Очередь Kafka&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#78350F&quot;&gt;Топик: stock.reserved&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;Пропускает ровно 1 000&lt;br&gt;успешных резервов (Буфер)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="720" y="470" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="s_db" value="&lt;b&gt;Шаг 4. PostgreSQL (Склад и Заказы)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1E40AF&quot;&gt;Плавная пакетная запись (Batch Write)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;Нагрузка на диск снижена в 50 раз:&lt;br&gt;ровно 1 000 записей без блокировок&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#EBF3FE;strokeColor=#2563EB;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1040" y="465" width="270" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s_ttl" value="&lt;b&gt;Шаг 5. Таймер TTL (10 минут на оплату)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#374151&quot;&gt;• Если оплачено → резерв переходит в статус SOLD&lt;br&gt;• Если НЕ оплачено за 10 мин → авто-возврат +1 в Redis бакет&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="720" y="690" width="590" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e_s1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=1.5;" parent="1" source="s_gateway" target="s_b1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=1.5;" parent="1" source="s_gateway" target="s_b2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=1.5;" parent="1" source="s_gateway" target="s_b10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16A34A;strokeWidth=2;" parent="1" source="s_b2" target="s_kafka" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;" parent="1" source="s_kafka" target="s_db" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

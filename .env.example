# Конфигурация основного сервиса Маркетплейса (NFR: Конфигурируемость через ENV)
APP_NAME="Marketplace Fulfillment & Flash Sale Service"
APP_ENV="production"
DATABASE_URL="postgresql://marketplace_user:marketplace_pass@postgres:5432/marketplace_db"
REDIS_URL="redis://redis:6379/0"
PAYMENT_MOCK_URL="http://payment-mock:8001"
RESERVE_TTL_SECONDS=600
FLASH_SALE_BUCKETS=10
RATE_LIMIT_PER_MINUTE=1200
JWT_SECRET_KEY="super-secret-jwt-key-for-marketplace"
